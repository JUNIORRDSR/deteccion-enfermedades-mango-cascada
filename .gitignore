/.worktrees/
/.superpowers/
/.venv/
/provenance/runtime_state/
/data/derived/
/data/raw/
__pycache__/
*.pyc
*.pt
*.pth
*.onnx
*.whl
*.safetensors
*.cache
*.tmp

